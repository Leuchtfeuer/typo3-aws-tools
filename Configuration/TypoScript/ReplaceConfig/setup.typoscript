config.tx_awstools {
    enabled = 1

    patterns {
        10 {
            search = "/typo3temp/
            replace = "%s/typo3temp/
        }

        20 {
            search = "/typo3conf/
            replace = "%s/typo3conf/
        }

        30 {
            search = "/_assets/
            replace = "%s/_assets/
        }
    }

    replacer {
        eventListener = 1
        middleware = 1
    }
}
